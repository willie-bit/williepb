# Database: default SQLite for local dev; switch to Postgres for staging/prod
WILLIEPB_DATABASE_URL=sqlite:///./williepb.db
# WILLIEPB_DATABASE_URL=postgresql+psycopg://williepb:williepb@localhost:5432/williepb

WILLIEPB_ENV=dev
WILLIEPB_LOG_LEVEL=INFO

# --- External API credentials (leave blank to use stubs) ---

# Upbit
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 한국은행 ECOS (환율)
ECOS_API_KEY=

# 국토교통부 실거래가 (공공데이터포털)
MOLIT_API_KEY=

# 한국부동산원 R-ONE
REB_API_KEY=

# 증권사 OpenAPI (본인 계좌용; OAuth 토큰은 런타임에 저장)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
NH_APP_KEY=
NH_APP_SECRET=
